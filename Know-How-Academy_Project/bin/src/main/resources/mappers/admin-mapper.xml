<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="adminMapper">
	
	<!-- 신규가입자알람용쿼리 -->
	<select id="selectAlarmCount" resultType="_int">
		SELECT COUNT(*)
		  FROM MEMBER
		 WHERE STATUS='PENDING'
	</select>
	
</mapper>
	
	
