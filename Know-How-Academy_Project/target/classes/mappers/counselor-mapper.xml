<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="counselorMapper">

<!-- class 테이블 -->
    <resultMap id="classResultSet" type="Class">
	     <id column="CLASS_NO" property="classNo" />
	     <result column="CLASS_NAME" property="className" />
	     <result column="DESCRIPTION" property="description" />
	     <result column="STATUS" property="status" />
	     <result column="CREATED_AT" property="createdAt" />
	     <result column="UPDATED_AT" property="updatedAt" />
	     
	     <!-- 조인으로 가져오는 추가 정보 (학생이름, 학생연락처) -->
	    <result column="USER_NAME" property="userName"/>
	    <result column="PHONE" property="phone"/>
	  
	    
    </resultMap>

    <select id="selectClassDetailList" resultMap="classResultSet">
	    SELECT 
	        C.CLASS_NAME,
	        M.USER_NAME,
	        M.PHONE,
	        M.STATUS
	    FROM CLASS C
	    JOIN MEMBER M ON C.CLASS_NO = M.CLASS_NO
	   WHERE C.STATUS = 'Y'
	     AND M.ROLE_CODE = 'STUDENT'
    ORDER BY C.CLASS_NAME ASC
	</select>
</mapper>